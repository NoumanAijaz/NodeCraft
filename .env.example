# NodeCraft server environment — copy to .env and adjust.
# All variables are optional in development (safe defaults apply), but
# JWT_SECRET MUST be set in production — the server refuses to start without it.

# Port the Express server listens on (default: 3001)
# PORT=3001

# Allowed CORS origin for the frontend (default: http://localhost:5173)
# Set to your deployed frontend URL in production, e.g. https://app.example.com
# CLIENT_ORIGIN=http://localhost:5173

# REQUIRED in production. Must be a long random string (e.g. `openssl rand -hex 32`).
# The server exits at startup if this is missing when NODE_ENV=production.
# JWT_SECRET=

# "production" enables hardened error responses (no stack traces/messages leaked)
# and the JWT_SECRET requirement.
# NODE_ENV=production
